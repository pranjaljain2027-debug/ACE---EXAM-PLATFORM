# Heir of Wisdom — environment variables
#
# Copy to .env.local for local development. `.env.local` is gitignored.
# On Vercel these go in Project Settings → Environment Variables.
#
# Nothing here is secret except the Supabase anon key, which is still a public
# key by design: Supabase row-level security is what protects the data, not the
# secrecy of this value. Never put a service_role key in a NEXT_PUBLIC_ variable
# — anything with that prefix is shipped to the browser.

# --- Auth -------------------------------------------------------------------

# Which AuthProvider the app runs under.
#   unset / "demo"  → in-memory demo accounts, no persistence, NO parental data
#                     boundary (R14). Blocked from hosted environments by
#                     `npm run validate`.
#   "supabase"      → Supabase Auth, sessions and users managed server-side.
AUTH_PROVIDER=demo

# Supabase project. Required when AUTH_PROVIDER=supabase.
# Found in the Supabase dashboard under Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site -------------------------------------------------------------------

# The canonical origin, used by the sitemap and any absolute URL the app emits.
# Vercel sets this automatically for the deployment URL; set it to your custom
# domain so the sitemap points at the address you actually publish.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Demo data store --------------------------------------------------------

# Where the file-backed demo store writes. Only read in demo mode, and only in
# a writable filesystem — a serverless function cannot rely on it surviving
# between invocations, which is one more reason demo mode is local-only.
DEMO_DATA_FILE=.data/demo-store.json